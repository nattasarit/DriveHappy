# Hostinger injects PORT — do not hardcode in code
PORT=3000
NODE_ENV=production

# --- Tesla Fleet API (never wake / never command) ---
TESLA_CLIENT_ID=
TESLA_CLIENT_SECRET=
TESLA_REFRESH_TOKEN=
# Optional: seed access token; otherwise refreshed from TESLA_REFRESH_TOKEN
TESLA_ACCESS_TOKEN=
# Region base URL — pick the one for your Tesla account region
TESLA_API_BASE=https://fleet-api.prd.na.vn.cloud.tesla.com
TESLA_AUTH_BASE=https://fleet-auth.prd.vn.cloud.tesla.com
TESLA_VIN=LRWYHCFJ7SC322078
TESLA_REDIRECT_URI=https://hd.bkksoftkit.com/api/tesla/callback
# Optional light live vehicle_data only when already online (never wakes)
TESLA_ALLOW_LIVE_IF_ONLINE=true
# Soft monthly Tesla upstream call budget (~$10 credit). Soft-stop fetches when hit.
TESLA_SOFT_LIMIT_CALLS=4000

# Cache TTLs (ms)
CACHE_TTL_VEHICLE_MS=600000
CACHE_TTL_VEHICLES_LIST_MS=180000
CACHE_TTL_LIVE_VEHICLE_MS=180000
CACHE_TTL_WEATHER_MS=900000
CACHE_TTL_NEWS_MS=900000
CACHE_TTL_GOLD_MS=900000
CACHE_TTL_BTC_MS=120000
CACHE_TTL_YOUTUBE_MS=300000

# Widgets
# Weather: client sends browser geolocation; Bangkok used only as server fallback
WEATHER_FALLBACK_LAT=13.7563
WEATHER_FALLBACK_LON=100.5018
NEWS_FEED_URL=https://www.thairath.co.th/rss/news
# Thai gold (ราคาบาท) — override if needed
GOLD_API_URL=https://api.chnwt.dev/thai-gold-api/latest

# YouTube (optional Data API key improves search; otherwise Piped proxies)
YOUTUBE_API_KEY=
# Comma-separated Piped API bases (tried in order)
PIPED_API_BASES=https://api.piped.private.coffee,https://pipedapi.kavin.rocks,https://pipedapi.adminforge.de
