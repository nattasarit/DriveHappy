# Hostinger injects PORT — do not hardcode in code
PORT=3000
NODE_ENV=production

# --- Tesla Fleet API (never wake / never command) ---
TESLA_CLIENT_ID=
TESLA_CLIENT_SECRET=
TESLA_REFRESH_TOKEN=
# Optional: seed access token; otherwise refreshed from TESLA_REFRESH_TOKEN
TESLA_ACCESS_TOKEN=
# Region base URL — pick the one for your Tesla account region
TESLA_API_BASE=https://fleet-api.prd.na.vn.cloud.tesla.com
TESLA_AUTH_BASE=https://fleet-auth.prd.vn.cloud.tesla.com
TESLA_VIN=LRWYHCFJ7SC322078
TESLA_REDIRECT_URI=https://hd.bkksoftkit.com/api/tesla/callback
# Optional light live vehicle_data only when already online (never wakes)
TESLA_ALLOW_LIVE_IF_ONLINE=true
# Soft monthly Tesla upstream call budget (~$10 credit). Soft-stop fetches when hit.
TESLA_SOFT_LIMIT_CALLS=4000

# Cache TTLs (ms)
CACHE_TTL_VEHICLE_MS=600000
CACHE_TTL_VEHICLES_LIST_MS=180000
CACHE_TTL_LIVE_VEHICLE_MS=180000
CACHE_TTL_WEATHER_MS=900000
CACHE_TTL_NEWS_MS=900000
CACHE_TTL_GOLD_MS=900000
CACHE_TTL_BTC_MS=120000
CACHE_TTL_YOUTUBE_MS=300000

# Widgets
# Weather: client sends browser geolocation; Bangkok used only as server fallback
WEATHER_FALLBACK_LAT=13.7563
WEATHER_FALLBACK_LON=100.5018
NEWS_FEED_URL=https://www.thairath.co.th/rss/news
# Thai gold (ราคาบาท) — override if needed
GOLD_API_URL=https://api.chnwt.dev/thai-gold-api/latest

# YouTube
# Data API key improves SEARCH only (not stream URLs). Optional.
YOUTUBE_API_KEY=
# Optional cookies from a logged-in browser session to reduce “Sign in to confirm you’re not a bot”
# when resolving streams from Hostinger’s datacenter IP. Personal use only — never commit.
# Same-origin: hd.bkksoftkit.com CANNOT read youtube.com cookies automatically — paste/export required.
# Example Cookie header: SID=...; HSID=...; __Secure-3PSID=...
# Or paste Netscape cookies.txt contents (also accepted by admin UI).
YOUTUBE_COOKIES=
# Shared secret for /youtube-cookies-admin.html and POST /api/youtube/cookies (leave empty to disable paste API)
YOUTUBE_COOKIE_ADMIN_TOKEN=
# Comma-separated Piped API bases (batched in parallel)
PIPED_API_BASES=https://api.piped.private.coffee,https://pipedapi.ducks.party,https://pipedapi.adminforge.de,https://pipedapi.kavin.rocks,https://pipedapi.reallyaweso.me
# Comma-separated Invidious API bases (stream/search fallback)
INVIDIOUS_API_BASES=https://inv.nadeko.net,https://invidious.nerdvpn.de,https://yewtu.be,https://invidious.flokinet.to
